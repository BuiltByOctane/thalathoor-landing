{
  "name": "thalathoor-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Static marketing site for Thalathoor Heritage Homestay, Kasaragod, Kerala.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "assets": "npm run assets:images && npm run assets:video && npm run assets:svg",
    "assets:images": "node scripts/optimize-images.mjs",
    "assets:video": "node scripts/optimize-video.mjs",
    "assets:svg": "svgo --precision=2 --multipass -q assets/logo/logo.svg -o assets/logo/logo.svg",
    "check": "node scripts/check-assets.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.35.3",
    "svgo": "^3.3.4"
  }
}
